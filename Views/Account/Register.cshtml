@model RegisterViewModel
@{ ViewData["Title"] = "Register"; }
<div class="row justify-content-center"><div class="col-md-5">
    <h2>Register</h2>
    <p class="text-muted">New accounts are created as <strong>Farmer</strong>. An admin can assign Agronomist or Admin roles.</p>
    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Role" value="Farmer" />
        <div class="mb-3"><label asp-for="Username" class="form-label"></label><input asp-for="Username" class="form-control" /><span asp-validation-for="Username" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" /><span asp-validation-for="Password" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
        <button class="btn btn-success">Create account</button>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
